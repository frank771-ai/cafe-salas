APP_NAME="Origen Tico"
APP_ENV=production
APP_KEY=GENERAR_EN_EL_SERVIDOR_Y_NO_PUBLICAR
APP_DEBUG=false
APP_URL=https://tienda.ejemplo.com
ALLOW_SIMULATED_PAYMENTS_IN_PRODUCTION=false

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=origen_tico
DB_USERNAME=origentico_app
DB_PASSWORD=CAMBIAR_POR_UN_SECRETO_LARGO

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
