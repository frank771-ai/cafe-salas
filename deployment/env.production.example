APP_NAME="Café Salas"
APP_ENV=production
APP_KEY=GENERAR_EN_EL_SERVIDOR_Y_NO_PUBLICAR
APP_DEBUG=false
APP_URL=https://tienda.ejemplo.com
ALLOW_SIMULATED_PAYMENTS_IN_PRODUCTION=false

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_DATABASE=/RUTA/ABSOLUTA/cafe-salas/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@cafesalas.test"
MAIL_FROM_NAME="${APP_NAME}"
