APP_NAME="Café Salas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://cafe-salas.test
ALLOW_SIMULATED_PAYMENTS_IN_PRODUCTION=false

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CR

LOG_CHANNEL=stack
LOG_LEVEL=debug

# MariaDB/MySQL se conserva únicamente como alternativa para XAMPP.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cafe_salas
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@cafesalas.test"
MAIL_FROM_NAME="${APP_NAME}"
FILESYSTEM_DISK=local
